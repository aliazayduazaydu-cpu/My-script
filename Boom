--==================================================
-- تشغيل الصوت
--==================================================

play.MouseButton1Click:Connect(function()

	if checking then
		return
	end

	local id = customInput.Text:gsub("%D","")

	if id == "" then

		status.Text = "⚠ اكتب كود الأغنية"
		status.TextColor3 = Color3.fromRGB(255,200,70)

		return
	end

	checking = true

	sound:Stop()
	sound.SoundId = "rbxassetid://" .. id

	-- تكرار تلقائي
	sound.Looped = true

	status.Text = "⏳ جاري تحميل الصوت..."
	status.TextColor3 = Color3.fromRGB(255,220,70)

	local loaded = false

	local connection = sound.Loaded:Connect(function()
		loaded = true
	end)

	local success = pcall(function()
		sound:Play()
	end)

	local startTime = os.clock()

	while os.clock() - startTime < 8 do

		if loaded or sound.IsLoaded then
			break
		end

		task.wait(0.1)
	end

	connection:Disconnect()

	task.wait(0.2)

	if success and sound.IsLoaded and sound.TimeLength > 0 then

		sound.Looped = true

		if not sound.IsPlaying then
			sound:Play()
		end

		status.Text = "🔁 الصوت يعمل ويتكرر"
		status.TextColor3 = Color3.fromRGB(70,255,130)

	else

		sound:Stop()

		status.Text = "⚠ الصوت غير متاح"
		status.TextColor3 = Color3.fromRGB(255,75,75)

	end

	checking = false

end)

