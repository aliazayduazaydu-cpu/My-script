-- FLY SYSTEM
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local plr = Players.LocalPlayer
local mouse = plr:GetMouse()
local FlySpeed = 50
local Fly = false
local FlyToggle = false
local FlyPadVisible = false
local BodyVelocity = nil
local BodyGyro = nil
local FlyA = false
local FlyD = false
local FlyW = false
local FlyS = false

FlyAButton.MouseButton1Down:Connect(function() FlyA = true end)
FlyAButton.MouseButton1Up:Connect(function() FlyA = false end)
FlyDButton.MouseButton1Down:Connect(function() FlyD = true end)
FlyDButton.MouseButton1Up:Connect(function() FlyD = false end)
FlyWButton.MouseButton1Down:Connect(function() FlyW = true end)
FlyWButton.MouseButton1Up:Connect(function() FlyW = false end)
FlySButton.MouseButton1Down:Connect(function() FlyS = true end)
FlySButton.MouseButton1Up:Connect(function() FlyS = false end)

Fly_Button.MouseButton1Click:Connect(function()
    if FlyToggle then
        FlyToggle = false
        Fly = false
        Fly_Pad.Visible = false
        if BodyVelocity then BodyVelocity:Destroy() end
        if BodyGyro then BodyGyro:Destroy() end
    else
        FlyToggle = true
        Fly = true
        Fly_Pad.Visible = true
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            BodyVelocity = Instance.new("BodyVelocity")
            BodyVelocity.Parent = plr.Character.HumanoidRootPart
            BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            BodyVelocity.Velocity = Vector3.new(0, 0, 0)
            BodyGyro = Instance.new("BodyGyro")
            BodyGyro.Parent = plr.Character.HumanoidRootPart
            BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            BodyGyro.CFrame = plr.Character.HumanoidRootPart.CFrame
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if Fly and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and BodyVelocity and BodyGyro then
        local moveDirection = Vector3.new(0, 0, 0)
        if FlyW then moveDirection = moveDirection + workspace.CurrentCamera.CFrame.LookVector end
        if FlyS then moveDirection = moveDirection - workspace.CurrentCamera.CFrame.LookVector end
        if FlyA then moveDirection = moveDirection - workspace.CurrentCamera.CFrame.RightVector end
        if FlyD then moveDirection = moveDirection + workspace.CurrentCamera.CFrame.RightVector end
        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit
        end
        BodyVelocity.Velocity = moveDirection * FlySpeed
        BodyGyro.CFrame = workspace.CurrentCamera.CFrame
    end
end)

FlySpeed_Input.FocusLost:Connect(function()
    FlySpeed = tonumber(FlySpeed_Input.Text) or 50
end)

