local function SetupCharacter(Char)

	Character = Char
	Humanoid = Char:WaitForChild("Humanoid")
	Root = Char:WaitForChild("HumanoidRootPart")

	CurrentVelocity = Vector3.zero

end

SetupCharacter(
	Player.Character or Player.CharacterAdded:Wait()
)

--========================================================
-- PLAYER OBJECTS
--========================================================

local function RemovePlayerObjects()

	if FlyVelocity then
		FlyVelocity:Destroy()
		FlyVelocity = nil
	end

	if FlyGyro then
		FlyGyro:Destroy()
		FlyGyro = nil
	end

end

local function CreatePlayerObjects()

	if not Root then
		return
	end

	RemovePlayerObjects()

	FlyVelocity = Instance.new("BodyVelocity")
	FlyVelocity.Name = "CameraVFlyVelocity"

	FlyVelocity.MaxForce = Vector3.new(
		math.huge,
		math.huge,
		math.huge
	)

	FlyVelocity.P = 100000
	FlyVelocity.Velocity = Vector3.zero
	FlyVelocity.Parent = Root

	FlyGyro = Instance.new("BodyGyro")
	FlyGyro.Name = "CameraVFlyGyro"

	FlyGyro.MaxTorque = Vector3.new(
		math.huge,
		math.huge,
		math.huge
	)

	FlyGyro.P = 1000000
	FlyGyro.D = 60
	FlyGyro.CFrame = Root.CFrame
	FlyGyro.Parent = Root

end

--========================================================
-- VEHICLE
--========================================================

local function GetVehicle()

	if not Humanoid then
		return nil, nil
	end

	local Seat = Humanoid.SeatPart

	if not Seat then
		return nil, nil
	end

	if not Seat:IsA("VehicleSeat") then
		return nil, nil
	end

	local Model =
		Seat:FindFirstAncestorOfClass("Model")

	if not Model then
		return nil, nil
	end

	local MainPart = Model.PrimaryPart

	if not MainPart then
		MainPart =
			Model:FindFirstChild("HumanoidRootPart")
	end

	if not MainPart then
		MainPart =
			Model:FindFirstChildWhichIsA(
				"BasePart",
				true
			)
	end

	return Model, MainPart

end

--========================================================
-- VEHICLE OBJECTS
--========================================================

local function RemoveVehicleObjects()

	if VehicleVelocity then
		VehicleVelocity:Destroy()
		VehicleVelocity = nil
	end

	if VehicleGyro then
		VehicleGyro:Destroy()
		VehicleGyro = nil
	end

	CurrentVehicle = nil

end

local function CreateVehicleObjects(Model, MainPart)

	if not MainPart then
		return
	end

	if CurrentVehicle == Model
		and VehicleVelocity
		and VehicleGyro then
		return
	end

	RemoveVehicleObjects()

	CurrentVehicle = Model

	VehicleVelocity =
		Instance.new("BodyVelocity")

	VehicleVelocity.Name =
		"CameraVehicleVelocity"

	VehicleVelocity.MaxForce =
		Vector3.new(
			math.huge,
			math.huge,
			math.huge
		)

	VehicleVelocity.P =
		150000

	VehicleVelocity.Velocity =
		Vector3.zero

	VehicleVelocity.Parent =
		MainPart

	VehicleGyro =
		Instance.new("BodyGyro")

	VehicleGyro.Name =
		"CameraVehicleGyro"

	VehicleGyro.MaxTorque =
		Vector3.new(
			math.huge,
			math.huge,
			math.huge
		)

	VehicleGyro.P =
		1500000

	VehicleGyro.D =
		50

	VehicleGyro.CFrame =
		MainPart.CFrame

	VehicleGyro.Parent =
		MainPart

end

--========================================================
-- STOP
--========================================================

local function StopEverything()

	RemovePlayerObjects()
	RemoveVehicleObjects()

	CurrentVelocity =
		Vector3.zero

end

--========================================================
-- RESPAWN
--========================================================

Player.CharacterAdded:Connect(function(Char)

	StopEverything()

	task.wait(0.3)

	SetupCharacter(Char)

	if Flying then
		CreatePlayerObjects()
	end

end)

