--========================================================
-- ⚡ FLIGHT ENGINE
--========================================================

RunService.RenderStepped:Connect(function(dt)

	if not Flying then
		return
	end

	if not Humanoid then
		return
	end

	local Camera =
		workspace.CurrentCamera

	if not Camera then
		return
	end

	local Look =
		Camera.CFrame.LookVector

	local Right =
		Camera.CFrame.RightVector

	--====================================================
	-- VEHICLE
	--====================================================

	local VehicleModel,
		VehicleRoot =
		GetVehicle()

	if VehicleModel and VehicleRoot then

		RemovePlayerObjects()

		CreateVehicleObjects(
			VehicleModel,
			VehicleRoot
		)

		if not VehicleVelocity
			or not VehicleGyro then
			return
		end

		local Move =
			Humanoid.MoveDirection

		local FlatLook =
			Vector3.new(
				Look.X,
				0,
				Look.Z
			)

		local FlatRight =
			Vector3.new(
				Right.X,
				0,
				Right.Z
			)

		if FlatLook.Magnitude > 0.001 then
			FlatLook =
				FlatLook.Unit
		end

		if FlatRight.Magnitude > 0.001 then
			FlatRight =
				FlatRight.Unit
		end

		local Forward =
			Move:Dot(
				FlatLook
			)

		local Side =
			Move:Dot(
				FlatRight
			)

		local Direction =
			Look * Forward

		Direction +=
			FlatRight * Side

		local Target =
			Vector3.zero

		if Direction.Magnitude > 0.001 then

			Target =
				Direction.Unit *
				FlySpeed

		end

		local Alpha =
			1 - math.exp(
				-Acceleration * dt
			)

		CurrentVelocity =
			CurrentVelocity:Lerp(
				Target,
				Alpha
			)

		VehicleVelocity.Velocity =
			CurrentVelocity

		-- تتبع الكاميرا مباشرة
		VehicleGyro.CFrame =
			CFrame.lookAt(
				VehicleRoot.Position,
				VehicleRoot.Position + Look
			)

		VehicleRoot.AssemblyAngularVelocity =
			Vector3.zero

		return

	end

	--====================================================
	-- PLAYER
	--====================================================

	RemoveVehicleObjects()

	if not Root then
		return
	end

	if not FlyVelocity
		or not FlyVelocity.Parent then

		CreatePlayerObjects()

	end

	if not FlyVelocity
		or not FlyGyro then
		return
	end

	local Move =
		Humanoid.MoveDirection

	local FlatLook =
		Vector3.new(
			Look.X,
			0,
			Look.Z
		)

	local FlatRight =
		Vector3.new(
			Right.X,
			0,
			Right.Z
		)

	if FlatLook.Magnitude > 0.001 then
		FlatLook =
			FlatLook.Unit
	end

	if FlatRight.Magnitude > 0.001 then
		FlatRight =
			FlatRight.Unit
	end

	local Forward =
		Move:Dot(
			FlatLook
		)

	local Side =
		Move:Dot(
			FlatRight
		)

	local Direction =
		Look * Forward

	Direction +=
		FlatRight * Side

	local Target =
		Vector3.zero

	if Direction.Magnitude > 0.001 then

		Target =
			Direction.Unit *
			FlySpeed

	end

	local Alpha =
		1 - math.exp(
			-Acceleration * dt
		)

	CurrentVelocity =
		CurrentVelocity:Lerp(
			Target,
			Alpha
		)

	FlyVelocity.Velocity =
		CurrentVelocity

	FlyGyro.CFrame =
		CFrame.lookAt(
			Root.Position,
			Root.Position + Look
		)

end)

